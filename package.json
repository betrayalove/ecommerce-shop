{
  "name": "internet-magazin",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "start": "concurrently -k -n api,web \"npm run server\" \"npm run dev\"",
    "dev": "node --env-file-if-exists=.env ./node_modules/webpack-cli/bin/cli.js serve",
    "build": "npm run typecheck && webpack --mode production",
    "preview": "node scripts/preview.cjs",
    "test": "jest",
    "server": "node --env-file-if-exists=.env --env-file-if-exists=server/.env server/index.js",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "typecheck": "tsc --noEmit",
    "test:server": "npm --prefix server test",
    "setup": "npm ci && npm --prefix server ci"
  },
  "dependencies": {
    "@fontsource/inter": "5.2.8",
    "@reduxjs/toolkit": "^2.0.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-redux": "^9.0.4",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@testing-library/jest-dom": "^6.1.5",
    "@testing-library/react": "^14.1.2",
    "@testing-library/user-event": "^14.5.1",
    "@types/jest": "^29.5.11",
    "@types/react": "^18.2.45",
    "@types/react-dom": "^18.2.18",
    "concurrently": "^9.1.2",
    "css-loader": "^7.1.2",
    "html-webpack-plugin": "^5.6.3",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "mini-css-extract-plugin": "^2.9.2",
    "sass": "^1.69.5",
    "sass-loader": "^16.0.4",
    "style-loader": "^4.0.0",
    "ts-jest": "^29.1.1",
    "ts-loader": "^9.5.1",
    "typescript": "^5.3.3",
    "webpack": "^5.96.1",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^6.1.0"
  },
  "engines": {
    "node": "24.x"
  }
}
