# Local Webpack proxies /api to this origin. Vercel uses API_ORIGIN server-side.
API_ORIGIN=http://localhost:3080
WEB_PORT=4173
PORT=3080
NODE_ENV=development
# Required in production: generate a unique random secret with at least 32 bytes.
# JWT_SECRET=
CORS_ORIGIN=http://localhost:4173,https://ecommerce-shop-seven-phi.vercel.app
# DATA_FILE=/absolute/path/to/users.json
